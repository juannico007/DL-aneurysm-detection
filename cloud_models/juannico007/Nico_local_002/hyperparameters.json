{
  "batch_size": 1,
  "csv_path": "train.csv",
  "data_dir": "h5-aneurysm",
  "epochs": 10,
  "grad_accum": 2,
  "input_shape": [
    256,
    256,
    256
  ],
  "learning_rate": 0.0001,
  "localizer_csv": "train_localizers.csv",
  "lr_reduction_epochs": 4,
  "max_voxels": 8388608,
  "mode": "local",
  "proportion_to_use": 0.1,
  "radius": 15,
  "scheduler": {
    "gamma": 0.96,
    "name": "step",
    "step_size": 100
  },
  "train_ratio": 0.7,
  "unet": {
    "activation": "relu",
    "class_output": 1,
    "conv_mode": "same",
    "dropout": 0,
    "in_channels": 1,
    "middle_neurons": 256,
    "n_blocks": 4,
    "normalization": "group4",
    "out_channels": 1,
    "start_filters": 16,
    "up_mode": "transposed"
  },
  "weight_decay": 0.01,
  "weights": [
    0.9,
    0.1
  ]
}