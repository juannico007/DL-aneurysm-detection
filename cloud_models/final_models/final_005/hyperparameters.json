{
  "batch_size": 20,
  "data_dir": "train_dataset.h5",
  "dice_only": true,
  "epochs": 40,
  "grad_accum": 2,
  "heatmap_decay": {
    "factor": 0.9,
    "metric": "val_loss",
    "min_sigma": 3.0,
    "mode": "min",
    "name": "plateau",
    "patience": 6
  },
  "heatmap_sigma": 5,
  "input_shape": [
    256,
    256,
    256
  ],
  "learning_rate": 0.0001,
  "loss_weights": {
    "alpha_max": 0.3,
    "alpha_min": 0.01,
    "alpha_schedule": "cosine",
    "background": 0.0,
    "beta": 1.0,
    "coord_scaler": 10.0,
    "lambda_max": 0.0,
    "lambda_tail": 0.1,
    "neg_ramp_epochs": 20
  },
  "lr_reduction_epochs": 10,
  "max_voxels": 125000000,
  "mode": "cloud",
  "neg_warmup_epochs": 0,
  "patch_csv": "train_patches.csv",
  "proportion_to_use": 1.0,
  "radius": 5,
  "scheduler": {
    "eta_min": 1e-06,
    "name": "cosine"
  },
  "train_ratio": 0.7,
  "unet": {
    "activation": "relu",
    "attention": true,
    "class_output": 1,
    "conv_mode": "same",
    "dropout": 0.2,
    "in_channels": 1,
    "legacy": false,
    "middle_neurons": 256,
    "n_blocks": 4,
    "normalization": "group4",
    "out_channels": 1,
    "regression": true,
    "start_filters": 16,
    "up_mode": "trilinear"
  },
  "weight_decay": 0.001,
  "description": "Just Curriculum Semimetric Dice loss"
}