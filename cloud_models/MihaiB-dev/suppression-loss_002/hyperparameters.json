{
  "batch_size": 20,
  "data_dir": "train_dataset.h5",
  "epochs": 20,
  "grad_accum": 2,
  "heatmap_decay_epoch": 50,
  "heatmap_sigma": 15,
  "input_shape": [
    256,
    256,
    256
  ],
  "learning_rate": 0.0001,
  "loss_weights": {
    "classification": 0.3,
    "segmentation": 0.7,
    "suppress": 0.1,
    "suppress_alpha": 2.0,
    "suppress_eps": 0.001,
    "suppress_tau": 0.3
  },
  "lr_reduction_epochs": 4,
  "max_voxels": 125000000,
  "mode": "cloud",
  "neg_warmup_epochs": 0,
  "patch_csv": "train_patches.csv",
  "proportion_to_use": 1.0,
  "radius": 15,
  "scheduler": {
    "factor": 0.5,
    "min_lr": 1e-06,
    "mode": "min",
    "name": "plateau",
    "patience": 5
  },
  "train_ratio": 0.7,
  "unet": {
    "activation": "relu",
    "class_output": 1,
    "conv_mode": "same",
    "dropout": 0.3,
    "in_channels": 1,
    "middle_neurons": 256,
    "n_blocks": 4,
    "normalization": "group4",
    "out_channels": 1,
    "start_filters": 16,
    "up_mode": "transposed"
  },
  "weight_decay": 0.01
}